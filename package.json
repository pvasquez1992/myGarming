{
  "name": "my-garmin-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "docs:prepare": "node scripts/prepare-swagger.mjs",
    "predev": "npm run docs:prepare",
    "dev": "wrangler dev --local --ip 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "db:migrate": "wrangler d1 migrations apply my-garmin --local",
    "data:import": "dotnet run --project tools/GarminImporter --",
    "db:seed": "node scripts/seed.mjs",
    "setup:local": "npm run db:migrate && npm run data:import && npm run db:seed",
    "pretest": "npm run docs:prepare",
    "test": "dotnet run --project tests/ImporterTests && node --test tests/api.test.mjs",
    "prebuild": "npm run docs:prepare",
    "build": "wrangler deploy --dry-run --outdir dist",
    "predeploy": "npm run docs:prepare",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "hono": "4.13.13"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261009.1",
    "swagger-ui-dist": "5.33.1",
    "typescript": "5.9.3",
    "wrangler": "4.149.0"
  }
}
